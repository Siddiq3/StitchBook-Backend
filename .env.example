# ============================================================================
# STEP 2: ENVIRONMENT CONFIGURATION FILE
# ============================================================================
# This file contains all configuration needed to run the backend
# 
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in each variable with your actual values
# 3. NEVER commit .env file to git
# 4. Keep .env.example for reference (this file)
# ============================================================================

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
# PORT: What port should the server listen on?
# Default: 5000
# For Render production, Render injects PORT automatically. 10000 is a safe local production-like default.
PORT=10000

# NODE_ENV: Environment mode
# Options: development, production
# Use 'development' locally, 'production' for deployment
NODE_ENV=production

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Choose ONE of these options:
# 
# Option 1: Supabase shared Session Pooler (RECOMMENDED for one long-running API)
# -------------------------------------------------------------------------------
# Supabase Dashboard > Connect > Session pooler.
# Use port 5432. This avoids requiring a dedicated IPv4 database add-on and keeps
# the application connection count small.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_POOLER_HOST:5432/postgres

# Start small for the first production API instance. Increase only after measuring
# pool wait time / database load.
DB_POOL_MAX=5
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=10000

# For providers with a private CA (such as Supabase), download the database's
# root certificate and configure ONE option. Certificate verification stays on.
# Render: upload a Secret File named database-ca.pem and use this path:
# DATABASE_SSL_CA_FILE=/etc/secrets/database-ca.pem
# Alternatively, set DATABASE_SSL_CA to the PEM contents (literal \n supported).
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# With a custom CA, sslmode/ssl URL options are removed to preserve verification.
# Remove sslcert, sslkey, and sslrootcert URL options when using these settings.

# 
# Option 2: Individual Database Config (for local PostgreSQL)
# ----------------------------------------------------------
# Uncomment these if using local PostgreSQL instead of Supabase
# 
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=tailor_app
# DB_USER=postgres
# DB_PASSWORD=your_postgres_password

# ============================================================================
# SUPABASE STORAGE
# ============================================================================
# Use a PRIVATE bucket. The API only returns short-lived signed upload/read URLs.
# Create the bucket in Supabase Storage with the same file-size/MIME restrictions.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=stitchbook-private
SUPABASE_STORAGE_MAX_BYTES=10485760

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================
# REDIS_URL: Redis connection string for session storage, rate limiting, and cache.
# Example for Upstash TLS Redis:
REDIS_URL=rediss://default:YOUR_PASSWORD@YOUR_UPSTASH_HOST:6379
REDIS_TLS=true

# Optional Redis host/port/password override
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password

# Optional key prefix to namespace all Redis data for this app.
# Useful when sharing Redis with other services.
REDIS_KEY_PREFIX=stitchbook:

# ============================================================================
# JWT CONFIGURATION
# ============================================================================
# JWT_SECRET: Secret key for signing JWT tokens
# ⚠️  IMPORTANT: Change this to a random string in production!
# Generate with: openssl rand -base64 32
JWT_SECRET=GENERATE_A_NEW_ACCESS_SECRET_AT_LEAST_32_CHARS

# JWT_EXPIRY: How long access tokens are valid
# Access tokens should be short-lived in production for better security.
# Recommended values: 15m, 30m, 1h
JWT_EXPIRY=15m

# JWT_REFRESH_SECRET: Secret for refresh tokens (optional)
# Used to issue new access tokens without re-login
JWT_REFRESH_SECRET=GENERATE_A_DIFFERENT_REFRESH_SECRET_AT_LEAST_32_CHARS

# JWT_REFRESH_EXPIRY: How long refresh tokens are valid
# Usually longer than the access token expiry, but still limited
JWT_REFRESH_EXPIRY=90d

# ============================================================================
# AUTHENTICATION CONFIGURATION
# ============================================================================
# Primary login: Google Sign-In
# Create OAuth client IDs in Google Cloud Console.
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your-google-android-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-google-ios-client-id.apps.googleusercontent.com

# Secondary login: mobile number through MSG91 OTP Widget
# MSG91_AUTH_KEY is used server-side to verify the widget access token.
# MSG91_WIDGET_ID and MSG91_WIDGET_TOKEN_AUTH are used by the backend mobile OTP flow.
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_WIDGET_ID=your-msg91-widget-id
MSG91_WIDGET_TOKEN_AUTH=your-msg91-widget-token-auth

# New shops can use the app during this many days before paid subscription is required.
FREE_TRIAL_DAYS=10

# ============================================================================
# LEGACY FIREBASE CONFIGURATION (Kept only for old clients during migration)
# ============================================================================
# Firebase Admin SDK configuration
# 
# FIREBASE_SERVICE_ACCOUNT: Firebase service account JSON (as string)
# Get from: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# 
# Copy the entire JSON and paste it here (as a stringified JSON)
# Example format:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project",...}
# 
# NOTE: Keep this ABSOLUTELY SECRET! Never share or commit to git.
# In production, use environment variables in your hosting platform.

FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-firebase-project","private_key_id":"key_id","private_key":"-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQE...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@your-project.iam.gserviceaccount.com","client_id":"123456789","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk@your-project.iam.gserviceaccount.com"}

# FIREBASE_PROJECT_ID: Your Firebase project ID (for reference)
FIREBASE_PROJECT_ID=your-firebase-project-id

# FIREBASE_API_KEY: Firebase API key (frontend use only)
FIREBASE_API_KEY=your-firebase-api-key

# ============================================================================
# CASHFREE CONFIGURATION (For Subscription Payments)
# ============================================================================
# Get from: https://merchant.cashfree.com
# 
# 
# Note: Keep these ABSOLUTELY SECRET!
# Never share or commit to git


# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
# LOG_LEVEL: How much detail to log?
# Options: error, warn, info, debug
# Development: info (shows important info)
# Production: warn (only warnings and errors)

LOG_LEVEL=warn
SLOW_QUERY_MS=250

# ============================================================================
# OPTIONAL: CORS CONFIGURATION
# ============================================================================
# BASE_URL: Public backend URL used to generate uploaded file URLs.
# WEB_APP_URL: Public website URL used for subscription/payment web flows.
# FRONTEND_URL / FRONTEND_URLS: Trusted browser origins allowed by CORS.
#
# You can also use a comma-separated list of trusted origins.
# FRONTEND_URLS=https://your-frontend.vercel.app,https://your-custom-domain.com

BASE_URL=https://stitchbook-backend.onrender.com
WEB_APP_URL=https://your-frontend.vercel.app
FRONTEND_URL=https://your-frontend.vercel.app
FRONTEND_URLS=https://your-frontend.vercel.app

# ============================================================================
# TRANSACTIONAL EMAIL / PASSWORD RESET
# ============================================================================
# Resend is the initial provider. Keep provider-specific code behind the email
# service abstraction so SES can replace it later without changing auth flows.
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_replace_with_your_server_side_key
EMAIL_FROM=StitchBook <no-reply@your-verified-domain.com>

# Use a separate random secret for OTP HMACs in production.
# Generate with: openssl rand -base64 48
PASSWORD_RESET_OTP_SECRET=replace_with_a_random_secret_at_least_32_chars
PASSWORD_RESET_OTP_EXPIRY_MINUTES=10
PASSWORD_RESET_OTP_RESEND_SECONDS=60
PASSWORD_RESET_OTP_MAX_ATTEMPTS=5

# ============================================================================
# STEP-BY-STEP SETUP
# ============================================================================
# 
# 1. Copy this file:
#    cp .env.example .env
# 
# 2. Get DATABASE_URL:
#    - If using Supabase:
#      Go to Supabase Dashboard > Settings > Database > PostgreSQL Connection
#      Copy the "Connection string"
#      Paste it here, replace "password" with your password
#    - If using Local PostgreSQL:
#      Use: postgresql://postgres:your_password@localhost:5432/tailor_app
# 
# 3. Generate JWT_SECRET:
#    Run: openssl rand -base64 32
#    Copy the output and paste here
# 
# 4. Get CASHFREE Keys (when needed):
#    Go to: https://merchant.cashfree.com
#    Get Test Keys first (not Live Keys)
#    Copy Key ID and Key Secret
# 
# 5. Save .env file
# 
# 6. Verify by running:
#    npm run dev
#    If you see "Server running on http://localhost:5000" - SUCCESS!
# 
# ============================================================================

# Cashfree Payment Gateway (server credentials only)
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2025-01-01

# Optional atomic monthly price configuration in INR (defaults: 299 / 399 / 599).
# Invalid configured values fail startup rather than silently charge a wrong price.
# SUBSCRIPTION_PRICES_JSON={"basic":299,"team":399,"pro":599}
